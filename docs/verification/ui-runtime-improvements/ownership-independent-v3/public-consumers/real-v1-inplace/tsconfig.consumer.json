{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "outDir": "compiled-real-v1-inplace-after"
  },
  "angularCompilerOptions": {
    "compilationMode": "full",
    "strictTemplates": true,
    "strictInjectionParameters": true
  },
  "include": [
    "consumer.ts"
  ]
}
