{
  "name": "ui-foundation",
  "version": "0.0.0",
  "private": true,
  "description": "Generate persona profiles, two-layer design tokens, Tailwind themes and Angular foundations from one YAML configuration.",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ui:sync": "tsx src/cli.ts sync --config examples/ui.config.example.yaml",
    "ui:check": "tsx src/cli.ts check --config examples/ui.config.example.yaml",
    "typecheck": "tsc -p tsconfig.tools.json && ngc -p tsconfig.json --noEmit && npm run typecheck:ui:media",
    "build": "npm run ui:check && ngc -p tsconfig.json && node scripts/build.mjs && tailwindcss -i tests/fixture-app/styles.css -o dist/fixture-app/styles.css",
    "start": "npm run build && node scripts/serve.mjs",
    "test": "npm run ui:check && npm run typecheck && npm run test:config && npm run test:generation && npm run test:model && npm run test:ui",
    "test:model": "tsx --test tests/model/*.test.ts",
    "test:config": "tsx --test tests/config/*.test.ts",
    "test:generation": "tsx --test tests/generation/*.test.ts",
    "test:ui": "playwright test",
    "typecheck:ui:media": "tsc -p tsconfig.ui-media.json"
  },
  "devDependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "8.0.1",
    "@lucide/angular": "1.52.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "4.3.0",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "rxjs": "7.8.2",
    "tailwindcss": "4.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "yaml": "2.9.1",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@dagrejs/dagre": "3.1.1",
    "echarts": "6.1.0",
    "fast-formula-parser": "1.0.19",
    "jsonc-parser": "3.3.1",
    "maplibre-gl": "6.12.0",
    "marked": "18.1.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "jsbarcode": "3.12.3",
    "@types/qrcode": "1.5.6",
    "@zxing/library": "0.23.0",
    "temporal-polyfill": "1.0.5"
  }
}
