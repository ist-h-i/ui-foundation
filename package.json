{
  "name": "ui-foundation",
  "version": "0.0.0",
  "private": true,
  "description": "Generate shared UI foundations, project skills and check policies from one approved project configuration.",
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "ngc -p tsconfig.json --noEmit",
    "build": "ngc -p tsconfig.json && node scripts/build.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "test": "npm run typecheck && npm run test:ui",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "rxjs": "7.8.2",
    "typescript": "6.0.3"
  }
}
