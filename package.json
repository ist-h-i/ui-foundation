{
  "name": "@hiroshi.inoue/ui-foundation",
  "version": "0.1.0",
  "private": false,
  "bin": {
    "ui-foundation": "dist/cli.js"
  },
  "files": [
    "LICENSE",
    "dist/cli.js",
    "dist/check-ui.cjs",
    "dist/checker-lib/",
    "dist/CLI-NOTICE.txt",
    "dist/CHECKER-NOTICE.txt",
    "dist/CLI-DEPENDENCIES.json",
    "templates/angular/**/*.ts",
    "templates/angular/**/*.css",
    "skills/ui-development/",
    "examples/ui.config.example.yaml",
    "assets/pdf-source/",
    "assets/third-party/",
    "docs/commands.ja.md",
    "docs/components.ja.md",
    "docs/design.md",
    "docs/static-checks.ja.md",
    "docs/ui-components.md",
    "docs/ui-library-consumer-guide.ja.md",
    "docs/ui-library-consumer-guide.en.md",
    "docs/npm-beta-readiness.ja.md",
    "docs/npm-beta-release-notes.ja.md",
    "docs/ui-library-tree-expansion-spec.ja.md",
    "docs/ui-library-scheduler-expansion-spec.ja.md",
    "docs/ui-library-table-expansion-spec.ja.md",
    "docs/ui-library-media-expansion-spec.ja.md",
    "docs/ui-library-specialist-expansion-spec.ja.md",
    "docs/ui-library-runtime-foundation-spec.ja.md",
    "docs/ui-library-api.json",
    "docs/ui-message-migration.en.md",
    "docs/ui-message-migration.ja.md",
    "docs/ui-message-map.json",
    "docs/ui-message-arguments.json",
    "README.ja.md",
    "examples/ui.config.example.en.yaml",
    "docs/commands.en.md",
    "docs/components.en.md",
    "docs/static-checks.en.md",
    "docs/npm-beta-readiness.en.md",
    "docs/npm-beta-release-notes.en.md",
    "docs/ui-library-tree-expansion-spec.en.md",
    "docs/ui-library-scheduler-expansion-spec.en.md",
    "docs/ui-library-table-expansion-spec.en.md",
    "docs/ui-library-media-expansion-spec.en.md",
    "docs/ui-library-specialist-expansion-spec.en.md",
    "docs/ui-library-runtime-foundation-spec.en.md",
    "docs/design.en.md",
    "docs/ui-components.en.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ist-h-i/ui-foundation.git"
  },
  "description": "Angular UI components, design tokens, Tailwind themes and AI development guidance from one YAML configuration. English and Japanese support.",
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "package:build": "npm run config:examples -- --check && npm run docs:tokens -- --check && node scripts/catalog-message-arguments.mjs --check && tsx scripts/build-package.ts",
    "prepack": "npm run package:build",
    "test:package": "node --test --test-concurrency=1 tests/package/*.test.mjs",
    "ui:sync": "tsx src/cli.ts sync --config examples/ui.config.repository.yaml",
    "ui:check": "tsx src/cli.ts check --config examples/ui.config.repository.yaml",
    "ui:check:warnings": "tsx src/warning-review-cli.ts",
    "typecheck": "tsc -p tsconfig.tools.json && ngc -p tsconfig.json --noEmit && npm run typecheck:ui:media && npm run typecheck:ui:runtime",
    "build": "npm run ui:check && ngc -p tsconfig.json && node scripts/build.mjs && tailwindcss -i tests/fixture-app/styles.css -o dist/fixture-app/styles.css",
    "start": "npm run build && node scripts/serve.mjs",
    "test": "npm run ui:check:warnings && npm run typecheck && npm run test:config && npm run test:generation && npm run test:package && npm run test:static && npm run test:model && npm run test:ui && npm run test:svg-paint",
    "test:model": "node scripts/catalog-message-arguments.mjs --check && tsx --test tests/model/*.test.ts",
    "config:examples": "tsx scripts/render-config-examples.ts",
    "docs:tokens": "tsx scripts/render-token-tables.ts",
    "test:config": "npm run docs:tokens -- --check && npm run config:examples -- --check && tsx --test tests/config/*.test.ts",
    "test:generation": "tsx --test --test-concurrency=1 tests/generation/*.test.ts",
    "test:ui": "playwright test",
    "typecheck:ui:media": "tsc -p tsconfig.ui-media.json",
    "typecheck:ui:runtime": "tsc -p tsconfig.ui-runtime.json",
    "test:cross-browser": "node scripts/run-cross-browser.mjs",
    "test:svg-paint": "node scripts/test-svg-paint.mjs",
    "audit:media": "node scripts/verification/audit-media.mjs",
    "verify:evidence:handoff": "python3 scripts/verification/build-handoff.py",
    "verify:evidence:cross-browser": "python3 scripts/verification/build-public-proof.py",
    "test:verification": "node --test tests/verification-tools/*.test.mjs",
    "test:static": "tsx --test --test-concurrency=1 tests/static/*.test.ts",
    "test:ui:radio:cross-browser": "node scripts/run-cross-browser.mjs --suite=virtual-radio",
    "test:package:audit": "node --test tests/package-audit/*.test.mjs",
    "audit:package": "node scripts/audit-package.mjs"
  },
  "devDependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "8.0.1",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@dagrejs/dagre": "3.1.1",
    "@lucide/angular": "1.52.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "4.3.0",
    "@types/node": "26.6.4",
    "@types/qrcode": "1.5.6",
    "@zxing/library": "0.23.0",
    "echarts": "6.1.0",
    "esbuild": "0.28.2",
    "fast-formula-parser": "1.0.19",
    "jsbarcode": "3.12.3",
    "jsonc-parser": "3.3.1",
    "maplibre-gl": "6.12.0",
    "marked": "18.1.0",
    "pdfjs-dist": "6.4.299",
    "postcss": "8.5.30",
    "postcss-scss": "4.0.9",
    "postcss-selector-parser": "7.1.6",
    "postcss-value-parser": "4.2.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "qrcode": "1.5.4",
    "rxjs": "7.8.2",
    "tailwindcss": "4.3.0",
    "temporal-polyfill": "1.0.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "release-candidate"
  }
}
